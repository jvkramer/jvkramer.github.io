% --- Command to change default annotation color ---
% Usage: \setannotationcolor{RGB}{144,26,30}
%    or: \setannotationcolor{named}{jambrotomato}
\newcommand{\setannotationcolor}[2]{%
    \ifx#1RGB\relax
        \definecolor{carandache}{RGB}{#2}%
    \else
        \colorlet{carandache}{#2}%
    \fi
}


