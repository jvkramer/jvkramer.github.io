%% jambro-annotations.sty
%% ===========================================================================
%% Hand-Drawn Annotation Package for LaTeX Beamer
%% Extracted from beamerthemejambro.sty by Ambrogio Cesa-Bianchi
%% Standalone version: Feb 2026
%% ===========================================================================
%%
%% DESCRIPTION:
%% Provides hand-drawn (pencil-style) annotation capabilities including:
%% - Pencil-style arrows and underlines
%% - Hand-drawn boxes around text
%% - Annotation notes with curved arrows
%% - Inline directional arrows
%% - Text highlighting
%% - Marker nodes for TikZ overlay positioning
%%
%% USAGE:
%% \usepackage{jambro-annotations}
%% \usepackage[night]{jambro-annotations}     % Dark mode colors
%% \usepackage[red]{jambro-annotations}       % Red color scheme
%%
%% ===========================================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{jambro-annotations}[2026/02/13 Hand-drawn annotation tools]

%=============================================================================
%  PACKAGE OPTIONS
%=============================================================================

\newif\if@JambroRed
\newif\if@JambroNight

\@JambroRedfalse
\@JambroNightfalse

\DeclareOption{red}{\@JambroRedtrue}
\DeclareOption{night}{\@JambroNighttrue}
\ProcessOptions\relax


%=============================================================================
%  REQUIRED PACKAGES
%=============================================================================

